{
  "name": "ielts-learning-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1 -p 3005",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3005",
    "start:local": "node scripts/start-local.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/cli.ts db backup",
    "db:restore": "tsx scripts/cli.ts db restore",
    "cli": "tsx scripts/cli.ts",
    "profile:list": "tsx scripts/cli.ts profile list",
    "profile:create": "tsx scripts/cli.ts profile create",
    "profile:rename": "tsx scripts/cli.ts profile rename",
    "profile:delete": "tsx scripts/cli.ts profile delete",
    "progress:unlock": "tsx scripts/cli.ts progress unlock",
    "progress:reset": "tsx scripts/cli.ts progress reset",
    "points:show": "tsx scripts/cli.ts points show",
    "points:adjust": "tsx scripts/cli.ts points adjust",
    "settings:list": "tsx scripts/cli.ts settings list",
    "settings:get": "tsx scripts/cli.ts settings get",
    "settings:set": "tsx scripts/cli.ts settings set",
    "band:list": "tsx scripts/cli.ts band list",
    "band:activate": "tsx scripts/cli.ts band activate",
    "band:import": "tsx scripts/cli.ts band import",
    "doctor": "tsx scripts/cli.ts doctor",
    "content:validate": "tsx scripts/content-import.ts validate",
    "content:import": "tsx scripts/content-import.ts import",
    "content:import:all": "tsx scripts/content-import.ts import --dir content/gt-listening --publish && tsx scripts/content-import.ts import --dir content/gt-bank --publish && tsx scripts/content-import.ts import --dir content/gt-modules/3.3.3 --publish",
    "bank:validate": "tsx scripts/bank-validate.ts",
    "listening:check": "tsx scripts/listening-check.ts",
    "listening:build": "tsx scripts/listening-build.ts",
    "bench:gt": "tsx scripts/bench-gt-writing.mts",
    "bench:ai": "node scripts/bench-ai.mjs",
    "format": "prettier --write .",
    "coverage": "vitest run -c vitest.coverage.config.ts --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.90.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "8.6.0",
    "file-type": "21.3.4",
    "lucide-react": "0.546.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pino": "9.14.0",
    "radix-ui": "1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.65.0",
    "react-markdown": "10.1.0",
    "recharts": "3.3.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.11",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-security": "3.0.1",
    "jsdom": "27.0.1",
    "postcss": "8.5.32",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
