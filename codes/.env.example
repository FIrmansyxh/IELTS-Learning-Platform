# Salin ke `codes/.env` lalu isi nilai rahasia. JANGAN commit `.env`.
# Buat rahasia acak:  openssl rand -hex 24   (password, tanpa karakter khusus agar aman di URL)
#                     openssl rand -base64 32 (AUTH_SECRET, IP_HMAC_SECRET)
# Di PowerShell:      [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])

# --- Umum ---
NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Asia/Jakarta

# --- Database (db) ---
POSTGRES_DB=ielts
POSTGRES_USER=postgres_admin
# Wajib acak >= 24 karakter, BUKAN "postgres"
POSTGRES_PASSWORD=
APP_RW_PASSWORD=
APP_MIGRATOR_PASSWORD=
# URL untuk proses di HOST (npm run dev, db:migrate dari host). Compose menyusun URL internal
# (host `db`) sendiri dari *_PASSWORD di atas. Dev memakai docker-compose.dev.yml (127.0.0.1:5432).
DATABASE_URL=postgres://app_rw:GANTI_APP_RW_PASSWORD@127.0.0.1:5432/ielts
DATABASE_MIGRATOR_URL=postgres://app_migrator:GANTI_APP_MIGRATOR_PASSWORD@127.0.0.1:5432/ielts
# Opsional: bila kosong, Testcontainers dipakai untuk integration test
TEST_DATABASE_URL=

# --- Auth & keamanan ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# true hanya bila di belakang Caddy
AUTH_TRUST_HOST=false
# Healthcheck container memakai 127.0.0.1:3000
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
IP_HMAC_SECRET=

# --- Bootstrap admin (dibaca sekali oleh `npm run admin:bootstrap`, SPEC-001) ---
ADMIN_EMAIL=owner@example.test
ADMIN_INITIAL_PASSWORD=

# --- Nilai awal app_settings (hanya dipakai oleh db:seed pertama) ---
SIGNUP_MODE=invite
AI_DAILY_LIMIT_PER_USER=10
AUDIO_RETENTION_DAYS=90

# --- Storage ---
ASSETS_DIR=/data/assets
# fs | s3
STORAGE_DRIVER=fs
# Hanya bila STORAGE_DRIVER=s3 (profil minio)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ielts-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Batas unggahan (MB) ---
UPLOAD_MAX_MB_RECORDING=10
UPLOAD_MAX_MB_AUDIO_ASSET=50
UPLOAD_MAX_MB_IMAGE=5
UPLOAD_MAX_MB_DOCUMENT=25
UPLOAD_MAX_MB_IMPORT=5

# GENERAL_TRAINING (default) | ACADEMIC: sub-modul bertag jenis lain disembunyikan dari learner (ADR-004)
EXAM_MODULE=GENERAL_TRAINING

# --- AI (kill-switch; false = self-assessment) ---
AI_ENABLED=false
# llamacpp | ollama | mock  (default llamacpp, ADR-004)
LLM_DRIVER=llamacpp
# llama-server (llama.cpp) di host; WAJIB bind 127.0.0.1
LLAMACPP_BASE_URL=http://127.0.0.1:8080
# Label model (llama-server melayani satu model). Dikunci setelah `npm run bench:ai`
LLAMACPP_MODEL_WRITING=qwen2.5-7b-instruct-q4_k_m
# Penilaian Speaking otomatis ditunda pada MVP (ADR-004): speaking dilatih lewat prompt eksternal
SPEAKING_AI_ENABLED=false
# Driver ollama (opsional, tidak lagi default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_WRITING=qwen2.5:3b-instruct
OLLAMA_MODEL_SPEAKING=qwen2.5:3b-instruct
OLLAMA_KEEP_ALIVE=5m
# whisper | mock
STT_DRIVER=whisper
STT_BASE_URL=http://stt:8080
# base | small  (berkas ggml-<model>.bin di volume whisper_models)
STT_MODEL=base
AI_JOB_TIMEOUT_SEC=180
AI_NUM_PREDICT=1500

# --- Backup (di luar repo) ---
# Contoh Windows: D:/ielts-backups
BACKUP_DIR=
# Zona waktu POSIX untuk jadwal 02:00 (image alpine tanpa tzdata): WIB-7
BACKUP_TZ=WIB-7

# --- Proxy (profil `proxy`) ---
# Host publik yang dilayani Caddy (HTTPS); `localhost` memakai CA internal Caddy
PROXY_SITE=localhost
