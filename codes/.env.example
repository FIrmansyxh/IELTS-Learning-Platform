# `npm run start:local` membuat codes/.env dari berkas ini dan mengisi AUTH_SECRET serta IP_HMAC_SECRET
# dengan nilai acak. JANGAN commit `.env`. Membuat rahasia manual: openssl rand -base64 32
# Di PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])

# --- Umum ---
NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Asia/Jakarta

# --- Database (SQLite lokal, SPEC-025) ---
# Berkas database. Bawaan: ./data/ielts.db (dibuat otomatis oleh `npm run db:migrate`)
# DATABASE_PATH=./data/ielts.db

# --- Auth & keamanan ---
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3005
AUTH_TRUST_HOST=false
# Hanya loopback yang dilayani (start:local menurunkan nilai ini dari --port)
ALLOWED_HOSTS=localhost:3005,127.0.0.1:3005
IP_HMAC_SECRET=

# --- Nilai awal app_settings (hanya dipakai oleh db:seed pertama) ---
AI_DAILY_LIMIT_PER_USER=10
AUDIO_RETENTION_DAYS=90

# --- Storage ---
ASSETS_DIR=./data/assets
# fs | s3
STORAGE_DRIVER=fs
# Opsional, tidak dipakai bawaan: hanya bila STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Batas unggahan (MB) ---
UPLOAD_MAX_MB_RECORDING=10
UPLOAD_MAX_MB_AUDIO_ASSET=50
UPLOAD_MAX_MB_IMAGE=5
UPLOAD_MAX_MB_DOCUMENT=25
UPLOAD_MAX_MB_IMPORT=5

# GENERAL_TRAINING (default) | ACADEMIC: sub-modul bertag jenis lain disembunyikan dari learner (ADR-004)
EXAM_MODULE=GENERAL_TRAINING

# --- AI (kill-switch; false = self-assessment) ---
AI_ENABLED=false
# llamacpp | ollama | mock  (default llamacpp, ADR-004)
LLM_DRIVER=llamacpp
# llama-server (llama.cpp) di host; WAJIB bind 127.0.0.1
LLAMACPP_BASE_URL=http://127.0.0.1:8080
# Opsional: bila AI_ENABLED=true, `npm run start:local` menyalakan llama-server sendiri (hanya loopback)
# LLAMACPP_BIN=llama-server
# Model penilai Writing (ADR-004, addendum 2026-11-11): gpt-oss-20b MXFP4 (berkas 12,1 GB).
# Butuh sekitar 3,4 GB VRAM + 10-11 GB RAM (diukur di RTX 3060 6 GB / RAM 32 GB); RAM 16 GB belum diuji.
# LLAMACPP_MODEL_PATH=G:\llm-models\gpt-oss-20b-MXFP4.gguf
# atau unduh dari Hugging Face:
# LLAMACPP_HF_REPO=ggml-org/gpt-oss-20b-GGUF:MXFP4
# -c 6144 dan --n-cpu-moe 20 sesuai konfigurasi benchmark; sesuaikan --n-cpu-moe dengan VRAM Anda.
# LLAMACPP_ARGS=--device Vulkan0 -ngl 99 --n-cpu-moe 20 -c 6144
# Label model (llama-server melayani satu model); dicatat di audit evaluasi.
LLAMACPP_MODEL_WRITING=gpt-oss-20b-mxfp4
# Penilaian Speaking otomatis ditunda pada MVP (ADR-004): speaking dilatih lewat prompt eksternal
SPEAKING_AI_ENABLED=false
# Driver ollama (opsional, tidak lagi default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_WRITING=qwen2.5:3b-instruct
OLLAMA_MODEL_SPEAKING=qwen2.5:3b-instruct
OLLAMA_KEEP_ALIVE=5m
# whisper | mock
STT_DRIVER=whisper
STT_BASE_URL=http://127.0.0.1:8081
# base | small  (model whisper, hanya bila STT dipakai)
STT_MODEL=base
# gpt-oss-20b: median sekitar 70 dtk, evaluasi pertama setelah server dinyalakan bisa >250 dtk (benchmark).
# Naikkan dari 180 bila kerap timeout.
AI_JOB_TIMEOUT_SEC=300
AI_NUM_PREDICT=1500

# Listening TTS lokal (opsional, hanya untuk npm run listening:build; lihat scripts/tts/README.md)
# TTS_ENGINE_CMD=<folder>/ielts-tts/venv/Scripts/kokoro-tts.exe
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
