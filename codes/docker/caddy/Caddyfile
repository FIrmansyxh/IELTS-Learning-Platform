# Profil `proxy`. PROXY_SITE: `localhost` (CA internal Caddy) atau host publik/tailnet.
{
	# Sertifikat lokal untuk host non-publik; Caddy mengelola sendiri untuk domain publik.
	admin 127.0.0.1:2019
}

{$PROXY_SITE:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# tls internal dipakai otomatis oleh Caddy untuk localhost/IP; untuk domain publik memakai ACME.
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
}
